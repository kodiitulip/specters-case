; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Specter's Case"
config/name_localized={
"en": "Specter's Case",
"pt_BR": "Caso do Espectro"
}
config/description="A protagonista Pam, recém se formou como uma Investigadora Paranormal e recebeu seu primeiro caso. A vizinhança de _Frost Hollow_ recentemente têm reportado um número grande de ocorrências paranormais e precisa da sua ajuda. Investigue a vizinhança e interrogue seus habitantes para descobrir a origem das atividades anormais e libertar essa comunidade dos espíritos que a assombra."
run/main_scene="uid://b7glbwlwtqvmi"
config/use_custom_user_dir=true
config/custom_user_dir_name="FlowerGarden/Specter's Case"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.10022258, 0.13610247, 0.23731115, 1)
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/image="uid://7d83fqjtscx6"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=2500
boot_splash/bg_color.editor_hint=Color(0.14, 0.14, 0.14, 1)
boot_splash/image.editor_hint=""
boot_splash/fullsize.editor_hint=true
boot_splash/use_filter.editor_hint=false

[autoload]

SceneTransitionManager="*res://scenes/managers/scene_transition/scene_transition.tscn"
OverlayLayer="*res://scripts/managers/overlay_layer.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
GlobalSignalBus="*res://scripts/managers/signal_bus.gd"
GlobalInventory="*res://scripts/managers/global_inventory.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
GlobalVariables="*res://scripts/managers/global_variables.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[dialogic]

directories/dch_directory={
"errante": "res://resources/dialogic/characters/errante.dch",
"pam": "res://resources/dialogic/characters/pam.dch"
}
directories/dtl_directory={
"blockage": "res://resources/dialogic/dialogs/blockage.dtl",
"blocking": "res://resources/dialogic/dialogs/ghost/blocking.dtl",
"elevator_fail": "res://resources/dialogic/dialogs/out/elevator_fail.dtl",
"ending_demo": "res://resources/dialogic/dialogs/ending_demo.dtl",
"errante": "res://resources/dialogic/dialogs/ghost/errante.dtl",
"fireplace": "res://resources/dialogic/dialogs/fireplace.dtl",
"fireplace_success": "res://resources/dialogic/dialogs/fireplace_success.dtl",
"hotel_sign": "res://resources/dialogic/dialogs/out/hotel_sign.dtl",
"intro": "res://resources/dialogic/dialogs/intro.dtl",
"mirror": "res://resources/dialogic/dialogs/toilet/mirror.dtl",
"mirror_success": "res://resources/dialogic/dialogs/toilet/mirror_success.dtl",
"player_lost": "res://resources/dialogic/dialogs/ghost/player_lost.dtl",
"straw_doll_fail": "res://resources/dialogic/dialogs/loot/straw_doll_fail.dtl",
"straw_doll_success": "res://resources/dialogic/dialogs/loot/straw_doll_success.dtl",
"toilet": "res://resources/dialogic/dialogs/toilet/toilet.dtl",
"toilet_fail": "res://resources/dialogic/dialogs/toilet/toilet_fail.dtl",
"toilet_success": "res://resources/dialogic/dialogs/toilet/toilet_success.dtl",
"water_candle": "res://resources/dialogic/dialogs/water_pipe/water_candle.dtl",
"water_looking_glass": "res://resources/dialogic/dialogs/water_pipe/water_looking_glass.dtl",
"you_got_item": "res://resources/dialogic/dialogs/loot/you_got_item.dtl",
"you_got_item_toilet": "res://resources/dialogic/dialogs/loot/you_got_item_toilet.dtl"
}
layout/style_directory={
"battle": "res://resources/dialogic/themes/battle.tres"
}
layout/style_list=["res://resources/dialogic/themes/battle.tres"]
variables={
"battle_scene_uuid": "uid://c2fhrlxr43suj",
"calm": false,
"debug": false,
"puzzles": {
"item_icon": "",
"item_name": "",
"water_code": ""
},
"toilet": false
}
layout/default_style="Default"
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autocolor_names=true
choices/reveal_delay=0
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
glossary/default_case_sensitive=true

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=2
window/size/borderless=true
window/stretch/mode="canvas_items"
window/handheld/orientation=4
window/size/mode.editor_hint=0
window/size/borderless.editor_hint=false

[editor]

naming/script_name_casing=2

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

